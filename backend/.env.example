# SMART Assistant 配置模板：复制为 backend/.env 后按需修改。
# 复制命令（PowerShell）：Copy-Item .env.example .env
# 优先级：系统环境变量 > .env 文件 > 代码默认值。.env 已被 gitignore，不会入库。

# ---------- 服务 ----------
# 监听地址
SMART_ASSISTANT_ADDR=127.0.0.1:3000
# 数据库路径
SMART_ASSISTANT_DB=smart_assistant.db
# 日志级别（error/warn/info/debug/trace）
RUST_LOG=info

# ---------- 大模型 ----------
LLM_API_URL=http://127.0.0.1:1234/v1/completions
LLM_API_KEY=
LLM_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive
# 记忆提取专用模型：留空则复用 LLM_MODEL。记忆判定/事实化是质量关键，
# 推荐拆给更强（或专门微调）的模型，对话模型只管聊天
LLM_EXTRACT_MODEL=

# ---------- 角色设定 ----------
# 每轮对话/主动推送都以"最高优先级硬约束"注入（性格、说话口癖、背景等）。
# 例：PERSONA=你是晓彤，25 岁的小学老师，性格安静温柔，说话简短带点俏皮，自称"晓彤"
PERSONA=

# ---------- 向量模型（维度/模型变更不会自动重建：启动会提醒，确认后运行
#  cargo run --bin smart-assistant-memory -- rebuild，只重建向量，记忆内容不丢） ----------
EMBEDDING_API_URL=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
EMBEDDING_DIM=768

# ---------- 记忆（分层 + 质量） ----------
# 召回的相似度阈值（欧氏距离，≤ 该值才入选；默认 0.9，越小越严）。
# 太小会"失忆"、太大无关记忆每轮都注入；随 embedding 模型微调
MEMORY_RECALL_THRESHOLD=0.9
# 记忆去重阈值：新事实与库中某条距离 ≤ 该值时视为同一事实，不新增、只续期。
# 仅高度近似才去重，避免误杀同主题的不同事实（默认 0.25）
MEMORY_DEDUP_THRESHOLD=0.25
# 短期记忆存活天数（tier=short，如"身体不舒服"）；到期后召回不再出现
MEMORY_SHORT_TTL_DAYS=7
# 意向记忆存活天数（tier=intent，如"打算下个月去看电影"）
MEMORY_INTENT_TTL_DAYS=90

# ---------- HTTPS（留空则用 certs/server.pem + certs/server.key；都没有则跑 HTTP） ----------
SMART_ASSISTANT_TLS_CERT=
SMART_ASSISTANT_TLS_KEY=

# ---------- 前端静态托管 ----------
SMART_ASSISTANT_WEB_DIST=../frontend/dist

# ---------- Telegram 通道（留空 Token 则不启动） ----------
# @BotFather 申请
TELEGRAM_BOT_TOKEN=
# 白名单 chat id，逗号分隔；留空不限制（公网部署建议只放自己）
#TELEGRAM_ALLOWED_IDS=123456789
# 代理（api.telegram.org 国内直连不了时填，如 http://127.0.0.1:7890）
#TELEGRAM_PROXY=
# 下面两个是通用兜底，TG 和 HTTP 客户端都会读
#HTTPS_PROXY=
#ALL_PROXY=

# ---------- 微信 iLink 通道 ----------
# 设为 1 则启动时走扫码登录（首次）；已有 token/会话文件时可不设
ILINK_ENABLED=
# 手动指定 bot_token 可跳过扫码（扫码成功后会自动写入会话文件）
ILINK_BOT_TOKEN=
# 会话文件（保存扫码凭证，重启免扫）
ILINK_SESSION_FILE=ilink_session.json
# 白名单微信用户 id（xxx@im.wechat），逗号分隔；留空不限制
#ILINK_ALLOWED_IDS=
# context_token 新鲜窗口（小时）：过期后需用户再发消息刷新（微信端通常约 24h / 10 次主动外发）
ILINK_CONTEXT_MAX_AGE_HOURS=12

# ---------- 主动陪伴（PROACTIVE_ENABLED=1 开启） ----------
# AI 会在随机间隔主动给最近聊过的用户发消息（Telegram 无限制可随时推；
# iLink 只在用户发过消息后的 token 窗口内可推）。每轮至多主动发一条。
PROACTIVE_ENABLED=0
# 随机间隔范围（分钟）：每次等待时间在这个区间内随机取，不规律更像真人
PROACTIVE_MIN_MINUTES=45
PROACTIVE_MAX_MINUTES=180
# 安静时段（本机时间，HH-HH 半开区间；起止相同 = 无安静时段；默认 23:00~6:59 不打扰）
PROACTIVE_QUIET_HOURS=23-7
# 每用户每天主动消息上限
PROACTIVE_DAILY_LIMIT=8
# 距用户最后发言至少静默多少小时后才可能被主动联系（避免打断热聊）
PROACTIVE_MIN_SILENCE_HOURS=2
# 距用户最后发言超过多少天还未回复，则不再主动打扰（避免骚扰沉睡用户）
PROACTIVE_MAX_IDLE_DAYS=7
# 每轮回复后最多连续追加的语句数：话题有延展性时 AI 会像真人一样接着说
# （倾诉/吐槽/讨论进行中会连发多条；结束类话题"忙/睡/不想聊"则自然收住）；
# 设为 0 关闭该能力
PROACTIVE_MAX_FOLLOWUPS=3

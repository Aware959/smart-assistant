# SMART Assistant 配置模板：复制为 backend/.env 后按需修改。
# 复制命令（PowerShell）：Copy-Item .env.example .env
# 优先级：系统环境变量 > .env 文件 > 代码默认值。.env 已被 gitignore，不会入库。

# ---------- 服务 ----------
# 两个后端进程（共享同一份 .env / smart_assistant.db，可只跑其一或同时跑）：
#   sa-web  会话主进程：HTTP(S) Web API + 前端静态托管
#   sa-link 通道守护：Telegram / iLink 长轮询 + 意图主动开口
# 命令行问话用 sa-cli；向量表维护用 sa-mem（见下方）。
# 监听地址
SMART_ASSISTANT_ADDR=127.0.0.1:3000
# 数据库路径
SMART_ASSISTANT_DB=smart_assistant.db
# 日志级别（error/warn/info/debug/trace）
RUST_LOG=info

# ---------- 可观测 / 链路追踪 ----------
# 常规文本日志镜像到文件的路径；留空只输出 stdout。
SMART_ASSISTANT_LOG_FILE=
# 链路追踪 JSON 落盘路径（一行一事件，target=trace）：记录每轮对话/决策的 trace_id
# 与各环节（历史/召回/提示词/回复/记忆判定/意图决策）及耗时。
# 留空不写。回放一次请求：在该文件里按 trace_id 或 session_id 过滤即可。
SMART_ASSISTANT_TRACE_FILE=
# 追踪日志是否记录内容全文（召回记忆/提示词/回复/判定原文）。
# 0/缺省只记摘要（条数/字符数），避免默认把内容大量落盘。
TRACE_CONTENT=0
# 进程假死诊断心跳文件路径（独立 OS 线程每 5s 落一行）；留空不写。
SMART_ASSISTANT_WATCHDOG_FILE=

# ---------- 大模型 ----------
# 提供方：openai（默认，OpenAI 兼容端点，兼容 LM Studio/llama.cpp/Groq/DeepSeek/Moonshot 等）
#        | google（Google AI Studio Gemini；流式与 json_schema 结构化输出均支持）
LLM_PROVIDER=openai
LLM_API_URL=http://127.0.0.1:1234/v1/completions
LLM_API_KEY=
LLM_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive
# 结构化输出模式：
#   json_schema（默认，OpenAI/Gemini/本地 llama.cpp/Groq Qwen：强约束+压思考段）
#   json_object（DeepSeek 等不支持 json_schema 的端点，仅提示工程约束）
LLM_STRUCTURED_OUTPUT=json_schema

# ---------- 角色设定 ----------
# 人设数据源为 DB 表 self_profile（KV：性格/人格/三观/爱好…），每轮对话/主动推送
# 都以"最高优先级硬约束"注入。若你没有修改过表结构，可临时用以下命令直观确认：
#   sqlite3 smart_assistant.db "SELECT key, value FROM self_profile ORDER BY rowid;"
# 变更人设请直接对表增删改（v1 人工维护，不提供管理界面）。

# ---------- 向量模型（维度/模型/距离度量变更都不会自动重建：启动会提醒，确认后运行
#  cargo run --bin sa-mem -- rebuild，只重建向量，记忆内容不丢。
#  距离度量已固定为 cosine 且不可配置：改度量会让旧距离全部失去可比性） ----------
EMBEDDING_API_URL=http://127.0.0.1:1234/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
EMBEDDING_DIM=768

# ---------- 记忆（分层 + 质量） ----------
# 召回的最低余弦相似度（≥ 该值才入选；默认 0.79，越大越严）。
# 太小会"失忆"、太大无关记忆每轮都注入；随 embedding 模型微调。
# 必须小于去重阈值——能被召回的记忆，相似度必须高到"几乎肯定是同一件事"
MEMORY_RECALL_MIN_SIMILARITY=0.79
# 记忆去重的最低余弦相似度（≥ 该值视为同一事实，不新增、只刷新）。
# 只是兜底：主要靠模型判断后用 remember 的 supersedes 改写旧记忆，
# 所以定得很紧（默认 0.92），避免悄悄吃掉一次纠正
MEMORY_DEDUP_MIN_SIMILARITY=0.92

# ---------- HTTPS（留空则用 certs/server.pem + certs/server.key；都没有则跑 HTTP） ----------
SMART_ASSISTANT_TLS_CERT=
SMART_ASSISTANT_TLS_KEY=

# ---------- 前端静态托管 ----------
SMART_ASSISTANT_WEB_DIST=../frontend/dist

# ---------- Telegram 通道（TELEGRAM_ENABLED=0 可强制不启动；否则看 Token） ----------
# @BotFather 申请
TELEGRAM_BOT_TOKEN=
# 硬开关：0 = 明确不启动 Telegram；缺省/1 = 开启（但仍需上面的 Token 非空）
TELEGRAM_ENABLED=1
# 白名单 chat id，逗号分隔；留空不限制（公网部署建议只放自己）
#TELEGRAM_ALLOWED_IDS=123456789
# 代理（api.telegram.org 国内直连不了时填，如 http://127.0.0.1:7890）
#TELEGRAM_PROXY=
# 下面两个是通用兜底，TG 和 HTTP 客户端都会读
#HTTPS_PROXY=
#ALL_PROXY=

# ---------- 贴纸（表情包） ----------
# 目录文件：模型可见的"选择键 → file_id"。由 sa-sticker 生成，文件不存在即无贴纸能力。
#   cargo run --bin sa-sticker -- fetch DzhersiTyan4   拉取并写入（覆盖）
#   cargo run --bin sa-sticker -- show                 查看当前目录
# file_id 是 bot 专属的，换 bot 要重拉；拉完重启 sa-link 才生效。
STICKER_CATALOG_FILE=sticker_catalog.json

# ---------- 微信 iLink 通道（硬开关：设 1 才连接） ----------
# 1 = 启动（有 token 直连，无 token 扫码登录）；0/留空 = 不启动，即使已有会话文件也不会连
ILINK_ENABLED=0
# 手动指定 bot_token 可跳过扫码（扫码成功后会自动写入会话文件）
ILINK_BOT_TOKEN=
# 会话文件（保存扫码凭证，重启免扫）
ILINK_SESSION_FILE=ilink_session.json
# 白名单微信用户 id（xxx@im.wechat），逗号分隔；留空不限制
#ILINK_ALLOWED_IDS=
# context_token 新鲜窗口（小时）：过期后需用户再发消息刷新（微信端通常约 24h / 10 次主动外发）
ILINK_CONTEXT_MAX_AGE_HOURS=12

# ---------- 意图判定（INTENT_ENABLED=1 开启） ----------
# AI 侧决定"是否开口"：在随机间隔主动给最近聊过的用户发消息（Telegram 无限制可随时推；
# iLink 只在用户发过消息后的 token 窗口内可推）。每轮至多主动发一条。
INTENT_ENABLED=0
# 随机间隔范围（分钟）：每次等待时间在这个区间内随机取，不规律更像真人
INTENT_MIN_MINUTES=45
INTENT_MAX_MINUTES=180
# 安静时段（本机时间，HH-HH 半开区间；起止相同 = 无安静时段；默认 23:00~6:59 不打扰）
INTENT_QUIET_HOURS=23-7
# 距用户最后发言至少静默多少小时后才可能被主动联系（避免打断热聊）
INTENT_MIN_SILENCE_HOURS=2
# 距用户最后发言超过多少天还未回复，则不再主动打扰（避免骚扰沉睡用户）
INTENT_MAX_IDLE_DAYS=7

# ---------- 离线积压消息（无需配置，编译期常量） ----------
# 通道长轮询的拉取游标持久化在 meta 表，重启后从上次位置续传，不丢弃离线期消息。
# 取回的消息按"用户真实发出时刻"分档（core/session/sessions.rs）：
#   ≤15 分钟      → 当实时消息正常回
#   15 分钟 ~24h  → 正常回，并在提示词告知模型"这是几小时前发的"，
#                   由它自己决定怎么接（可说"刚看到"），不假装刚收到
#   >24 小时      → 只入库留痕，不触发任何回复
# 主动陪伴的静默窗口同样按真实发出时刻计算（不用接收时刻）。
# 上限 24h 刻意与 Telegram 服务端的 update 保留窗口对齐：
# 关机超过 24h 的消息服务端也已丢弃，任何实现都救不回来。

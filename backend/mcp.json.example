{
  "mcpServers": {
    "comfy": {
      "command": "comfy-mcp",
      "args": [],
      "env": {
        "COMFY_BIN": "C:/ComfyUI/venv/Scripts/comfy.exe"
      },
      "tools": ["server_info", "run_workflow", "job_status", "wait_for_job", "fetch_outputs"],
      "timeout_secs": 300,
      "confirm": {
        "default": true,
        "tools": {
          "server_info": false,
          "job_status": false,
          "fetch_outputs": false
        }
      }
    },
    "fetch": {
      "url": "http://127.0.0.1:3425/mcp/run/fetch",
      "headers": {},
      "confirm": {
        "default": false
      }
    }
  }
}

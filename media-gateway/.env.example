# media-gateway 配置模板：复制为 media-gateway/.env 后按需修改。
# 优先级：进程环境变量 > .env 文件 > 代码默认值。.env 已被 gitignore，不会入库。

# ---------- 服务 ----------
# 监听端口（需与 Rust 后端 backend/.env 的 MEDIA_GATEWAY_URL 一致）
PORT=8787

# ---------- 扩散后端 ----------
# 后端类型：a1111 | comfyui
DIFFUSION_BACKEND_TYPE=comfyui
# 后端 API 基址（看 StabilityMatrix / ComfyUI 监听端口；ComfyUI 默认 8188，A1111 默认 7860）
DIFFUSION_BACKEND_URL=http://127.0.0.1:8188

# 单次生成总超时（秒）：图片可能很慢，超时即返回 504
MEDIA_HTTP_TIMEOUT=120

# ---------- ComfyUI 专用 ----------
# 推荐：从 ComfyUI 里 "Save (API Format)" 导出你的工作流 JSON，指到这里。
# 里面已接好你的 checkpoint / 模型，只需把正向 prompt 注入下面指定的节点。
#COMFYUI_WORKFLOW_FILE=/绝对路径/你的_workflow.json
# 各节点 id 以你导出文件里的为准；下面是内置默认 SD1.5 工作流的对应 id（兜底用）
COMFYUI_PROMPT_NODE=6
COMFYUI_NEGATIVE_NODE=7
COMFYUI_SIZE_NODE=5
COMFYUI_KSAMPLER_NODE=3

# ---------- 语音（TTS） ----------
# 引擎：sapi（默认，Windows 离线：系统自带 SAPI 合成 WAV + ffmpeg 转 OGG/OPUS，零 Python 依赖，
#       只要 ffmpeg 在 PATH 即可，推荐的稳路子）
#       | edge-tts（联网，微软在线音色更好，但依赖 aiohttp；较新 Python（如 3.15）上往往装不上）
TTS_ENGINE=sapi
# 音色：sapi 填 SAPI 音色全名（如 Microsoft Huihui Desktop / Microsoft Kangkang / Microsoft Yaoyao）；
#       edge-tts 填其音色名（如 zh-CN-XiaoxiaoNeural）。
#       填 edge-tts 风格的 zh-* 名而本机没装同名 SAPI 音色时，会自动退到已安装的 zh-* 音色。
TTS_VOICE=zh-CN-XiaoxiaoNeural
# 可选：显式指定 SAPI 音色全名（优先级高于 TTS_VOICE）；留空走上面的逻辑
#SAPI_VOICE=Microsoft Huihui Desktop
# ffmpeg 可执行文件（sapi 引擎用它把 WAV 转成 OGG/OPUS；默认取 PATH 里的 ffmpeg，也可给绝对路径）
#FFMPEG_BIN=ffmpeg

# ---------- 语音识别（ASR，入站语音转文字）----------
# 引擎：faster-whisper（默认；可选依赖，未安装时网关照常启动，仅 /transcribe 返回 503）
#       | none / 留空（本网关不提供转写能力）
#
# ⚠️ 安装前提（用错解释器或依赖版本会直接崩，详见 gateway/asr/faster_whisper.py）：
#   1. 解释器必须 CPython 3.13：uv python install 3.13
#   2. 依赖必须锁 av<19：uv pip install faster-whisper "av<19"
#      （av 19.x 移除了 av.open(metadata_errors=...)，faster-whisper 1.2.1 仍在传该参数）
ASR_ENGINE=faster-whisper
# 模型规格或本地路径：tiny(75MB) / base / small(484MB，默认) / medium / large-v3
# 首次使用会从 HuggingFace 下载；国内网络不通时设 HF_ENDPOINT=https://hf-mirror.com
ASR_MODEL=small
# 识别语种：auto（默认，交给模型自判）或语言码（zh / en …）
ASR_LANGUAGE=auto
# 设备：cpu（默认）| cuda
ASR_DEVICE=cpu
# 计算精度：int8（默认，CPU 推荐）| float16（GPU）
ASR_COMPUTE_TYPE=int8
# 模型缓存/本地目录；留空用引擎默认（HuggingFace 缓存）
#ASR_MODEL_DIR=
# 启动时用后台线程预热模型（默认开）。关掉则第一次转写才加载，用户要等约 20 秒。
ASR_WARMUP=1

# ---------- 本机代理绕过（仅作用于本网关进程）----------
# 本机 Clash 等系统代理可能把 127.0.0.1 也路由进代理，导致网关连不上 ComfyUI。
# 让本网关进程的出站请求不走代理。只影响本进程，与 Rust/Telegram 无关。
# 注意：若把 TTS_ENGINE 切成 edge-tts 且需要经代理联网，请删掉这行。
NO_PROXY='*'

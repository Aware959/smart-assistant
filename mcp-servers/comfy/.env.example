# ComfyUI 出图 MCP 服务器的配置示例。
#
# 通常不用这个文件：MCP 客户端（backend/mcp.json）的 env 段才是主来源，
# 这里的值只作为本机手工调试时的兜底（进程已存在的环境变量优先，不覆盖）。

# ComfyUI API 基址
COMFYUI_URL=http://127.0.0.1:8188

# API 格式工作流 JSON（相对路径按本目录解析）；留空则用内置兜底工作流
COMFYUI_WORKFLOW_FILE=SD模板2.json

# 节点 id 覆盖（可选；类型对不上时自动识别兜底）
COMFYUI_PROMPT_NODE=3
COMFYUI_NEGATIVE_NODE=4
COMFYUI_SIZE_NODE=6
COMFYUI_KSAMPLER_NODE=5

# 单次出图总超时（秒）
COMFYUI_TIMEOUT=300

# UTF-8 模式：中文提示词与中文路径都按 UTF-8 处理
PYTHONUTF8=1

# Rust (backend/)
/target
/backend/target
/backend/target-alt
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# UniFFI 生成产物（由 uniffi generate 生成）
/backend/bindings

# 本地自签名 TLS 证书（由 backend/scripts/gen-cert.ps1 生成）
/backend/certs

# 一键启动脚本产生的后端日志
.dev-server.log
/logs

# 微信 iLink 扫码凭证（ Bearer token，密钥）
/backend/ilink_session.json
/backend/logs

# 贴纸目录（file_id 为当前 bot 专属，换 bot 即失效，属本地缓存）
/backend/sticker_catalog.json

# 本地临时归档（删目录 / 迁移前的安全快照，不入库）
/.backups/

# 编辑器
.vscode/
.idea/

*.tsbuildinfo

# Tauri desktop (desktop/)
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/preview.html

# Python MCP 服务器 (mcp-servers/)
mcp-servers/**/__pycache__/
mcp-servers/**/*.pyc
mcp-servers/**/.venv/

# MCP 服务器配置（本机路径与开关，含绝对路径，不入库；模板见 backend/mcp.json.example）
mcp.json
/backend/mcp.json

# Android (android/)
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
